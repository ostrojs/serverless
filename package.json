{
    "name": "@ostro/serverless",
    "version": "2.0.0-alpha.1",
    "description": "Serverless module for OstroJS",
    "main": "build/serverless.js",
    "scripts": {
        "test": "npx c8 npx jest",
        "build": "tsc -p tsconfig.build.json && node scripts/build.js",
        "prepublishOnly": "npm run build",
        "clean": "rm -rf build coverage"
    },
    "engines": {
        "node": ">=18.0.0"
    },
    "engineStrict": true,
    "keywords": [
        "serverless",
        "nodejs serverless",
        "lambda",
        "cloud function",
        "function"
    ],
    "author": "amar",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/ostrojs/serverless.git"
    },
    "bugs": {
        "url": "https://github.com/ostrojs/serverless/issues"
    },
    "homepage": "https://github.com/ostrojs/serverless#readme",
    "types": "build/serverless.d.ts",
    "files": [
        "build"
    ],
    "exports": {
        ".": {
            "types": "./build/serverless.d.ts",
            "default": "./build/serverless.js"
        },
        "./*": {
            "types": "./build/*.d.ts",
            "default": "./build/*.js"
        }
    },
    "devDependencies": {
        "@types/node": "^22.20.5",
        "typescript": "^5.8.0"
    },
    "overrides": {
        "sprintf-js": "^1.1.3",
        "braces": "^3.0.3",
        "argparse": "^2.0.1",
        "js-yaml": "^4.1.0"
    }
}
